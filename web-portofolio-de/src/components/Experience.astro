---
import { experiences } from '../data/experience';
---

<section id="experience" class="py-20 border-t border-slate-800/80 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section Konsisten & Berkelas -->
    <div class="space-y-2 mb-12">
      <div class="text-xs font-mono text-sky-400 uppercase tracking-wider">
        Pengalaman
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Perjalanan Karir &amp; Pengalaman
      </h2>
      <p class="text-sm text-slate-400 max-w-xl">
        Riwayat kontribusi profesional dalam pengembangan aplikasi web, rekayasa data pipeline ETL/ELT, arsitektur basis data, dan analitik bisnis.
      </p>
    </div>

    <!-- Timeline Container Vertikal -->
    <div class="relative pl-6 sm:pl-10 border-l-2 border-slate-800 space-y-10 sm:space-y-12">
      {experiences.map((item) => (
        <div class="relative group">
          
          <!-- Timeline Node Marker -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-6 flex items-center justify-center">
            {item.isCurrent ? (
              <span class="relative flex h-4 w-4">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-4 w-4 bg-[#090D16] border-2 border-emerald-400 items-center justify-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                </span>
              </span>
            ) : (
              <span class="w-3.5 h-3.5 rounded-full bg-[#090D16] border-2 border-slate-600 group-hover:border-sky-400 group-hover:scale-125 transition-all"></span>
            )}
          </div>

          <!-- Card Konten Pengalaman -->
          <div class="p-6 sm:p-7 rounded-2xl border border-slate-800/90 bg-slate-900/40 hover:bg-slate-900/70 hover:border-slate-700/80 transition-all duration-300 shadow-sm hover:shadow-xl backdrop-blur-sm space-y-4">
            
            <!-- Baris Atas: Info Perusahaan & Waktu -->
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
              
              <div class="flex items-start gap-3.5">
                <!-- Monogram Company Badge -->
                <div class="w-11 h-11 rounded-xl bg-slate-800/90 border border-slate-700/80 text-sky-400 flex items-center justify-center font-mono font-bold text-xs shrink-0 shadow-inner group-hover:border-sky-500/50 group-hover:text-white transition-all">
                  {item.id === 'exp-putra-wijayakusuma' ? 'PWS' : item.id === 'exp-importa' ? 'IJA' : 'BPS'}
                </div>

                <div class="space-y-1">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <h3 class="text-base sm:text-lg font-bold text-white tracking-tight group-hover:text-sky-300 transition-colors">
                      {item.role}
                    </h3>
                    {item.isCurrent && (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 text-[10px] font-mono font-semibold tracking-wide">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Posisi Saat Ini</span>
                      </span>
                    )}
                  </div>

                  <div class="flex items-center gap-2 text-xs font-mono text-slate-400 flex-wrap">
                    <span class="text-sky-400 font-semibold">{item.company}</span>
                    <span class="text-slate-600">·</span>
                    <span class="inline-flex items-center gap-1 text-slate-400">
                      <svg class="w-3 h-3 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span>{item.location}</span>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Periode & Tipe Kontrak -->
              <div class="flex sm:flex-col items-start sm:items-end gap-1.5 shrink-0 pt-1 sm:pt-0">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-950/80 border border-slate-800 text-slate-300 text-xs font-mono shadow-sm">
                  <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>{item.period}</span>
                </span>
                <span class="text-[11px] font-mono text-slate-500 px-1">
                  {item.type}
                </span>
              </div>

            </div>

            <!-- Ringkasan Peran Singkat & Jelas -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              {item.summary}
            </p>

            <!-- Highlights / Kontribusi Spesifik -->
            {item.highlights && item.highlights.length > 0 && (
              <div class="pt-1 space-y-2">
                <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
                  {item.highlights.map((h) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-sky-400 font-mono mt-1 shrink-0 text-xs">▹</span>
                      <span class="leading-relaxed text-slate-300">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Teknologi yang Digunakan -->
            <div class="pt-3 border-t border-slate-800/60 flex flex-wrap items-center gap-1.5">
              <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider mr-1">Stack:</span>
              {item.technologies.map((tech) => (
                <span class="px-2.5 py-1 rounded-md bg-slate-950/70 border border-slate-800/80 text-slate-300 hover:text-sky-300 hover:border-sky-500/40 text-[11px] font-mono transition-colors">
                  {tech}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
