---
import { experiences } from '../data/experience';
---

<section id="experience" class="py-20 border-t border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section Bersih -->
    <div class="space-y-2 mb-10">
      <div class="text-xs font-mono text-sky-400 uppercase tracking-wider">
        Pengalaman
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Perjalanan Karir &amp; Pengalaman
      </h2>

    </div>

    <!-- Daftar Pengalaman Bersih & Ringkas -->
    <div class="space-y-6">
      {experiences.map((item) => (
        <div class="p-6 rounded-xl border border-slate-800/80 bg-slate-900/30 space-y-3">
          
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <div class="space-y-0.5">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold text-white tracking-tight">
                  {item.role}
                </h3>
                {item.isCurrent && (
                  <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-mono font-medium">
                    Posisi Saat Ini
                  </span>
                )}
              </div>
              <div class="text-xs font-mono text-sky-400">
                {item.company} <span class="text-slate-500">· {item.location}</span>
              </div>
            </div>

            <div class="text-xs font-mono text-slate-400 self-start sm:self-auto">
              {item.period}
            </div>
          </div>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {item.summary}
          </p>

          {item.highlights && item.highlights.length > 0 && (
            <ul class="space-y-1.5 text-xs text-slate-300 pt-1">
              {item.highlights.map((h) => (
                <li class="flex items-start gap-2">
                  <span class="text-sky-400 font-mono mt-0.5">▹</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="flex flex-wrap gap-1.5 pt-1">
            {item.technologies.map((tech) => (
              <span class="px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800 text-[10px] font-mono">
                {tech}
              </span>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
