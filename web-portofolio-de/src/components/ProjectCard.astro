---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  githubUrl: string;
  image?: string;
  company?: string;
}

const {
  slug,
  title,
  description,
  category,
  tags,
  githubUrl,
  image,
  company,
} = Astro.props;
---

<div class="project-card group rounded-xl border border-slate-800/80 bg-slate-900/30 hover:border-sky-500/40 transition-colors flex flex-col justify-between overflow-hidden">
  
  <a href={`/projects/${slug}`} class="block">
    <!-- Gambar Thumbnail Bersih -->
    <div class="w-full aspect-[16/9] overflow-hidden bg-[#070A10] border-b border-slate-800/80">
      {image && (
        <img
          src={image}
          alt={title}
          width="800"
          height="450"
          decoding="async"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
        />
      )}
    </div>

    <!-- Konten Kartu Ringkas -->
    <div class="p-5 space-y-2">
      <div class="flex items-center justify-between gap-2 flex-wrap text-[11px] font-mono">
        <span class="text-sky-400 font-medium">
          {category}
        </span>
        {company ? (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-medium tracking-tight">
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
            </svg>
            <span>{company}</span>
          </span>
        ) : (
          <span class="px-1.5 py-0.5 rounded bg-slate-800/80 text-slate-400 text-[10px]">
            Personal Project
          </span>
        )}
      </div>

      <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-sky-300 transition-colors tracking-tight leading-snug">
        {title}
      </h3>

      <p class="text-xs text-slate-400 leading-relaxed line-clamp-2">
        {description}
      </p>

      <!-- Tag Teknologi Simpel -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-slate-900 text-slate-400 border border-slate-800">
            {tag}
          </span>
        ))}
        {tags.length > 4 && (
          <span class="px-1.5 py-0.5 text-[10px] font-mono text-slate-500">
            +{tags.length - 4}
          </span>
        )}
      </div>
    </div>
  </a>

  <!-- Footer Aksi Minimalis -->
  <div class="px-5 py-3 bg-slate-900/50 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors"
      onclick="event.stopPropagation();"
    >
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>GitHub</span>
    </a>

    <a
      href={`/projects/${slug}`}
      class="text-sky-400 hover:text-sky-300 font-medium flex items-center gap-1 group-hover:translate-x-0.5 transition-all"
    >
      <span>Lihat Detail →</span>
    </a>
  </div>

</div>
