---
import { skillCategories } from '../data/skills';

// Konfigurasi visual untuk masing-masing kategori
const categoryThemeMap = {
  sky: {
    borderHover: 'hover:border-sky-500/40',
    iconBg: 'bg-sky-500/10 text-sky-400 border-sky-500/20',
    dotColor: 'bg-sky-400',
    titleColor: 'text-sky-400',
    pillHover: 'hover:border-sky-500/40 hover:text-sky-200 hover:bg-sky-500/5',
    glowColor: 'from-sky-500/5',
  },
  amber: {
    borderHover: 'hover:border-amber-500/40',
    iconBg: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
    dotColor: 'bg-amber-400',
    titleColor: 'text-amber-400',
    pillHover: 'hover:border-amber-500/40 hover:text-amber-200 hover:bg-amber-500/5',
    glowColor: 'from-amber-500/5',
  },
  emerald: {
    borderHover: 'hover:border-emerald-500/40',
    iconBg: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
    dotColor: 'bg-emerald-400',
    titleColor: 'text-emerald-400',
    pillHover: 'hover:border-emerald-500/40 hover:text-emerald-200 hover:bg-emerald-500/5',
    glowColor: 'from-emerald-500/5',
  },
  indigo: {
    borderHover: 'hover:border-indigo-500/40',
    iconBg: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
    dotColor: 'bg-indigo-400',
    titleColor: 'text-indigo-400',
    pillHover: 'hover:border-indigo-500/40 hover:text-indigo-200 hover:bg-indigo-500/5',
    glowColor: 'from-indigo-500/5',
  },
  teal: {
    borderHover: 'hover:border-teal-500/40',
    iconBg: 'bg-teal-500/10 text-teal-400 border-teal-500/20',
    dotColor: 'bg-teal-400',
    titleColor: 'text-teal-400',
    pillHover: 'hover:border-teal-500/40 hover:text-teal-200 hover:bg-teal-500/5',
    glowColor: 'from-teal-500/5',
  },
  violet: {
    borderHover: 'hover:border-violet-500/40',
    iconBg: 'bg-violet-500/10 text-violet-400 border-violet-500/20',
    dotColor: 'bg-violet-400',
    titleColor: 'text-violet-400',
    pillHover: 'hover:border-violet-500/40 hover:text-violet-200 hover:bg-violet-500/5',
    glowColor: 'from-violet-500/5',
  },
};
---

<section id="skills" class="py-20 border-t border-slate-800/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section Bersih & Modern -->
    <div class="space-y-2 mb-10">
      <div class="text-xs font-mono text-sky-400 uppercase tracking-wider">
        Keahlian &amp; Toolkit
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Keahlian &amp; Teknologi
      </h2>

    </div>

    <!-- Grid Kategori Simetris (6 Kategori: 2 Kolom Seimbang) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => {
        const theme = categoryThemeMap[category.accentColor] || categoryThemeMap.sky;

        return (
          <div class={`group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/50 to-slate-950/70 p-6 backdrop-blur-sm ${theme.borderHover} transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-lg`}>
            
            <!-- Ambient Glow Effect pada sudut kartu -->
            <div class={`absolute -top-12 -right-12 w-32 h-32 bg-gradient-to-br ${theme.glowColor} to-transparent rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-500`}></div>

            <div class="space-y-5 relative z-10">
              
              <!-- Header Kartu Kategori -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  
                  <!-- Icon Container Berwarna -->
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center border ${theme.iconBg} shadow-sm shrink-0`}>
                    {category.categoryKey === 'data_engineering' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                      </svg>
                    )}
                    {category.categoryKey === 'databases' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                      </svg>
                    )}
                    {category.categoryKey === 'languages' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                      </svg>
                    )}
                    {category.categoryKey === 'web_development' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    )}
                    {category.categoryKey === 'business_intelligence' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                      </svg>
                    )}
                    {category.categoryKey === 'cloud_devops' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                      </svg>
                    )}
                  </div>

                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-white tracking-tight group-hover:text-white transition-colors">
                      {category.title}
                    </h3>
                  </div>
                </div>

                <!-- Badge Jumlah Tool -->
                <span class="text-[10px] font-mono text-slate-400 px-2 py-0.5 rounded-full bg-slate-900/90 border border-slate-800 shrink-0">
                  {category.skills.length} tools
                </span>
              </div>

              <!-- Pill Tag Teknologi Modern dengan Status Dot -->
              <div class="flex flex-wrap gap-2 pt-1">
                {category.skills.map((skill) => (
                  <div
                    class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900/90 text-slate-300 border border-slate-800/90 text-xs font-mono ${theme.pillHover} hover:scale-[1.02] transition-all duration-200 cursor-default shadow-sm`}
                    title={skill.description}
                  >
                    <span class={`w-1.5 h-1.5 rounded-full ${theme.dotColor} shrink-0 opacity-80 group-hover:opacity-100`}></span>
                    <span>{skill.name}</span>
                  </div>
                ))}
              </div>

            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
