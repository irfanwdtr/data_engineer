---
import { profile } from '../data/profile';
import DataNodesCanvas from './DataNodesCanvas.astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Interactive Data Circuit & Laser Stream Canvas Background -->
  <DataNodesCanvas />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Kolom Kiri: Headline, Identitas & Aksi Utama (Revamped & High-End) -->
      <div class="lg:col-span-7 space-y-6 relative">
        <!-- Soft Readability Shield: Menjamin teks 100% kontras, tajam, dan bebas interferensi animasi background -->
        <div class="absolute -inset-x-6 -inset-y-6 sm:-inset-x-8 sm:-inset-y-8 -z-10 bg-gradient-to-r from-[#090D16] via-[#090D16]/95 to-transparent rounded-3xl blur-2xl pointer-events-none"></div>

        
        <!-- Status Pill: Open to Work -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/80 shadow-[0_0_20px_rgba(56,189,248,0.15)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono font-medium text-slate-200">Tersedia untuk Posisi &amp; Proyek Rekayasa Data</span>
          <span class="px-1.5 py-0.2 rounded bg-emerald-500/15 text-emerald-400 text-[10px] font-mono font-bold tracking-wider">OPEN</span>
        </div>

        <!-- Headline Utama dengan Gradient Mengkilap -->
        <div class="space-y-2">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15]">
            Halo, saya <br />
            <span class="bg-gradient-to-r from-white via-sky-100 to-sky-400 bg-clip-text text-transparent drop-shadow-sm">
              {profile.name}
            </span>
          </h1>
          
          <div class="flex items-center gap-2.5 text-lg sm:text-xl font-mono pt-1">
            <span class="text-sky-400 font-bold tracking-tight">Data Engineer</span>
            <span class="text-slate-600 font-light">/</span>
            <span class="text-slate-300 font-medium">Web Developer</span>
          </div>
        </div>

        <!-- Deskripsi dengan Keyword Highlight Berbobot -->
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl">
          Berfokus pada perancangan <span class="text-white font-semibold">pipeline data otomatis (ETL/ELT)</span>, arsitektur <span class="text-sky-300 font-medium">Medallion Lakehouse</span>, dan pengelolaan data warehouse. Terbiasa membangun integrasi data skala besar menggunakan <span class="text-white font-medium">Python, SQL, Apache Airflow, PostgreSQL</span>, serta platform cloud <span class="text-sky-300 font-medium">AWS &amp; Databricks</span>.
        </p>

        <!-- Quick Highlight Badges (3 Fitur Kunci Rekayasa) -->
        <div class="flex flex-wrap items-center gap-2 pt-1 text-xs font-mono">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-200 shadow-sm backdrop-blur-sm">
            <span class="text-sky-400">⚡</span>
            <span>10+ Proyek Selesai</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-200 shadow-sm backdrop-blur-sm">
            <span class="text-emerald-400">🛡️</span>
            <span>Medallion Architecture</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-200 shadow-sm backdrop-blur-sm">
            <span class="text-amber-400">🚀</span>
            <span>20+ Tech Stack</span>
          </span>
        </div>

        <!-- Tombol Aksi Mewah, Tegas & Proporsional -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <!-- Tombol Utama: Jelajahi Proyek -->
          <a
            href="#projects"
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-sky-400 hover:from-sky-400 hover:to-sky-300 text-slate-950 font-bold text-xs font-mono shadow-[0_0_25px_rgba(56,189,248,0.35)] hover:shadow-[0_0_35px_rgba(56,189,248,0.5)] transition-all group cursor-pointer"
          >
            <span>Jelajahi Proyek</span>
            <span class="group-hover:translate-y-0.5 transition-transform text-sm font-bold">↓</span>
          </a>

          <!-- Tombol Sekunder: LinkedIn Resmi -->
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4.5 py-3 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/80 hover:border-sky-500/50 text-slate-200 hover:text-white text-xs font-mono transition-all backdrop-blur-md shadow-sm"
          >
            <svg class="w-3.5 h-3.5 fill-current text-sky-400" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
            <span class="text-slate-500 text-[10px]">↗</span>
          </a>

          <!-- Tombol Tersier: GitHub Resmi -->
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4.5 py-3 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-600 text-slate-200 hover:text-white text-xs font-mono transition-all backdrop-blur-md shadow-sm"
          >
            <svg class="w-3.5 h-3.5 fill-current text-slate-300" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </div>

      </div>

      <!-- Kolom Kanan: Terminal Simulasi Alur DAG Airflow dengan Ambient Glow 3D -->
      <div class="lg:col-span-5 relative group">
        
        <!-- Pendaran Cahaya Ambient Belakang Terminal (3D Glow Halo) -->
        <div class="absolute -inset-2 bg-gradient-to-r from-sky-500/20 via-emerald-500/15 to-sky-500/20 rounded-3xl blur-2xl opacity-60 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div class="relative rounded-2xl border border-slate-700/70 bg-[#080C14]/95 shadow-[0_20px_50px_rgba(0,0,0,0.6),0_0_35px_rgba(56,189,248,0.08)] backdrop-blur-xl overflow-hidden font-mono text-xs ring-1 ring-white/5">
          
          <!-- Garis Pendar Cahaya Halus di Bagian Atas Jendela -->
          <div class="absolute -top-px left-10 right-10 h-px bg-gradient-to-r from-transparent via-sky-400/50 to-transparent"></div>

          <!-- Header Jendela Terminal -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-900/90 border-b border-slate-800/90">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/90 shadow-[0_0_6px_rgba(244,63,94,0.4)]"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/90 shadow-[0_0_6px_rgba(245,158,11,0.4)]"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/90 shadow-[0_0_6px_rgba(16,185,129,0.4)]"></span>
              <span class="ml-2 text-slate-300 font-semibold text-[11px] tracking-wide">airflow_dag_pipeline.py</span>
            </div>
            
            <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold tracking-wider shadow-[0_0_12px_rgba(52,211,153,0.15)]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>DAG: ACTIVE</span>
            </div>
          </div>

          <!-- Simulasi Eksekusi Pipeline -->
          <div class="p-4 sm:p-5 space-y-4 text-slate-300">
            <div class="text-slate-500 text-[11px] italic font-mono">// Airflow DAG Definition &amp; Task Pipeline</div>
            
            <div class="space-y-1 text-xs">
              <div><span class="text-sky-400 font-medium">from</span> <span class="text-slate-200">airflow</span> <span class="text-sky-400 font-medium">import</span> <span class="text-amber-300 font-semibold">DAG</span></div>
              <div><span class="text-sky-400 font-medium">from</span> <span class="text-slate-200">operators.dbt</span> <span class="text-sky-400 font-medium">import</span> <span class="text-amber-300 font-semibold">DbtTransformOperator</span></div>
            </div>

            <!-- Visualisasi Langkah Pipeline -->
            <div class="pt-1 space-y-2.5">
              
              <!-- Task 1: Success -->
              <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800/90 hover:border-slate-700/80 transition-all flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
                  <span class="text-slate-200 font-medium">extract_raw_events</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold font-mono tracking-wide">
                  SUCCESS (42s)
                </span>
              </div>

              <!-- Task 2: Passed -->
              <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800/90 hover:border-slate-700/80 transition-all flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
                  <span class="text-slate-200 font-medium">validate_schema_quality</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold font-mono tracking-wide">
                  PASSED (18s)
                </span>
              </div>

              <!-- Task 3: Running (Highlighted) -->
              <div class="p-3 rounded-xl bg-sky-950/30 border border-sky-400/50 shadow-[0_0_20px_rgba(56,189,248,0.15)] ring-1 ring-sky-400/30 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="animate-spin w-3 h-3 border-2 border-sky-400 border-t-transparent rounded-full shadow-[0_0_8px_#38bdf8]"></span>
                  <span class="text-sky-100 font-semibold tracking-tight">dbt_build_data_marts</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-sky-500/15 text-sky-300 border border-sky-400/40 text-[10px] font-bold font-mono tracking-wider animate-pulse">
                  RUNNING...
                </span>
              </div>

              <!-- Task 4: Queued -->
              <div class="p-3 rounded-xl bg-slate-900/30 border border-slate-800/50 flex items-center justify-between opacity-60">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-slate-600"></span>
                  <span class="text-slate-400 font-medium">publish_bi_marts</span>
                </div>
                <span class="text-slate-500 text-[10px] font-mono tracking-wide">
                  QUEUED
                </span>
              </div>

            </div>

            <!-- Footer Metrik Terminal -->
            <div class="pt-3 border-t border-slate-800/80 grid grid-cols-2 gap-3 text-[11px]">
              <div>
                <span class="text-slate-500 text-[10px] uppercase font-mono tracking-wider block">Ingestion SLA:</span>
                <div class="flex items-center gap-1.5 text-emerald-400 font-semibold mt-0.5">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>&lt; 30s Target Met</span>
                </div>
              </div>

              <div>
                <span class="text-slate-500 text-[10px] uppercase font-mono tracking-wider block">Warehouse Target:</span>
                <div class="flex items-center gap-1.5 text-slate-200 font-semibold mt-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_6px_#38bdf8] shrink-0"></span>
                  <span>Partitioned PostgreSQL</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
