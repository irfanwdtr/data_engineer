---
import { profile } from '../data/profile';
import DataNodesCanvas from './DataNodesCanvas.astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-24 overflow-hidden">
  <!-- Interactive Data Nodes & Pipeline DAG Canvas Background -->
  <DataNodesCanvas />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Kolom Kiri: Teks & Aksi Bersih -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Status Kategori Ringkas -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/80 border border-slate-800 text-xs font-mono text-sky-400">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
          <span>Data Platform &amp; Pipeline Architecture</span>
        </div>

        <!-- Headline Utama -->
        <div class="space-y-1">
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Halo, saya <span class="text-sky-400">{profile.name}</span>
          </h1>
          <p class="text-lg sm:text-xl font-mono text-slate-400 font-medium">
            {profile.role}
          </p>
        </div>

        <!-- Deskripsi Singkat & Padat -->
        <p class="text-base text-slate-300 leading-relaxed max-w-xl">
          Saya adalah seorang Data Engineer yang berfokus pada pengembangan data pipeline, ETL automation. Memiliki pengalaman hands on dalam membangun proses integrasi, transformasi, dan pengelolaan data menggunakan Python, SQL, Apache Airflow, PostgreSQL, serta platform cloud seperti AWS.

        </p>

        <!-- Tombol Aksi Minimalis -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs font-mono shadow-sm hover:shadow-md transition-all"
          >
            <span>Lihat Proyek</span>
            <span>↓</span>
          </a>

          <div class="flex items-center gap-2 pl-1">
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Profil GitHub"
              class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-400 hover:text-white transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>

            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Profil LinkedIn"
              class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-400 hover:text-white transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Kolom Kanan: Terminal Simulasi Alur DAG Airflow (Tetap Sesuai Permintaan Pengguna) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-xl border border-slate-800 bg-[#0B0F17] shadow-xl overflow-hidden font-mono text-xs">
          
          <!-- Header Jendela Terminal -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-900/90 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-slate-400 text-[11px]">eksekusi_dag_airflow.py</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">DAG: AKTIF</span>
          </div>

          <!-- Simulasi Eksekusi Pipeline -->
          <div class="p-4 space-y-3.5 text-slate-300">
            <div class="text-slate-500">// Definisi DAG Airflow &amp; Status Task</div>
            
            <div class="space-y-1">
              <div class="text-slate-400"><span class="text-sky-400">from</span> airflow <span class="text-sky-400">import</span> DAG</div>
              <div class="text-slate-400"><span class="text-sky-400">from</span> operators.dbt <span class="text-sky-400">import</span> DbtTransformOperator</div>
            </div>

            <!-- Visualisasi Langkah Pipeline -->
            <div class="pt-2 space-y-2">
              <div class="p-2.5 rounded bg-slate-900 border border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="text-slate-200">ekstraksi_event_mentah</span>
                </div>
                <span class="text-emerald-400 text-[10px]">SUKSES (42d)</span>
              </div>

              <div class="p-2.5 rounded bg-slate-900 border border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="text-slate-200">validasi_kualitas_skema</span>
                </div>
                <span class="text-emerald-400 text-[10px]">LOLOS (18d)</span>
              </div>

              <div class="p-2.5 rounded bg-slate-900 border border-sky-500/40 bg-sky-950/20 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="animate-spin w-2.5 h-2.5 border-2 border-sky-400 border-t-transparent rounded-full"></span>
                  <span class="text-sky-200">dbt_bangun_data_marts</span>
                </div>
                <span class="text-sky-400 text-[10px]">BERJALAN...</span>
              </div>

              <div class="p-2.5 rounded bg-slate-900/40 border border-slate-800/60 flex items-center justify-between opacity-60">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-slate-600"></span>
                  <span class="text-slate-400">publikasi_marts_bi</span>
                </div>
                <span class="text-slate-500 text-[10px]">ANTREAN</span>
              </div>
            </div>

            <!-- Footer Metrik Terminal -->
            <div class="pt-2 border-t border-slate-800/80 grid grid-cols-2 gap-2 text-[11px]">
              <div>
                <span class="text-slate-500 block">SLA Ingesti:</span>
                <span class="text-emerald-400 font-semibold">&lt; Target 30d tercapai</span>
              </div>
              <div>
                <span class="text-slate-500 block">Database Warehouse:</span>
                <span class="text-slate-300 font-semibold">PostgreSQL Terpartisi</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
