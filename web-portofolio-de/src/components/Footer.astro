---
import { profile } from '../data/profile';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-[#070A10] text-slate-500 py-10 text-xs font-mono">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Kiri: Brand & Gelar -->
      <div class="flex items-center gap-2.5">
        <div class="flex items-center justify-center w-6 h-6 rounded bg-slate-900 border border-slate-800 text-sky-400 font-bold text-[10px]">
          IW
        </div>
        <span class="text-slate-300 font-medium">{profile.name}</span>
        <span class="text-slate-600">·</span>
        <span class="text-slate-400">Data Engineer</span>
      </div>

      <!-- Kanan: Hak Cipta -->
      <div class="text-slate-500 text-center md:text-right">
        <span>&copy; {currentYear} {profile.name}. Seluruh hak cipta dilindungi.</span>
      </div>

    </div>
  </div>
</footer>
