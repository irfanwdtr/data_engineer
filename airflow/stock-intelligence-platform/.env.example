# Database Configuration (PostgreSQL)
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Application Database
APP_DB_NAME=stock_intelligence
APP_DB_USER=stock_user
APP_DB_PASSWORD=your_app_password_here

# Apache Airflow Database
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=your_airflow_password_here

# Airflow Admin User
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=stock-platform-airflow:2.10.5
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password_here
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Backend Configuration
FASTAPI_PORT=8000
DEBUG=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

